        mk:EnumValue_申请状态_退回 ;
    mk:javaField "applyStatus" ;
    mk:ownerEntity "物料主数据" ;
    mk:supports mk:Scenario_物料精确查找 .

mk:refersTo a owl:ObjectProperty ;
