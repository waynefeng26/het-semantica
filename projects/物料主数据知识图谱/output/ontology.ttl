mk:CommonAttribute_制造商AVL等级属性 a owl:NamedIndividual,
        mk:CommonAttribute ;
    rdfs:label "制造商AVL等级属性"@zh ;
    rdfs:comment "物料对应制造商的AVL等级，每天晚上定时根据采购维护的制造商等级更新；研发设计BOM时优先考虑主力、合格、试用的物料；使用时只筛选这三个值，其他取值一律认为不及格。"@zh ;
    skos:altLabel "manufacturerAvlRating"@zh ;
    mk:attrCode "manufacturerAvlRating" ;
    mk:hasValue mk:EnumValue_制造商AVL等级_主力,
        mk:EnumValue_制造商AVL等级_合格,
        mk:EnumValue_制造商AVL等级_考察,
        mk:EnumValue_制造商AVL等级_试用,
        mk:EnumValue_制造商AVL等级_限制 ;
    mk:supports mk:Scenario_替代料推荐 .

