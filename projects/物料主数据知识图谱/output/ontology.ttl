mk:CommonAttribute_专用客户属性 a owl:NamedIndividual,
        mk:CommonAttribute ;
    rdfs:label "专用客户属性"@zh ;
    rdfs:comment "该属性有值表示物料是某个客户的专用料，属性值保存的是客户编码：A001为兰吉尔，A002为京瓷，目前只有这两个客户。"@zh ;
    skos:altLabel "notes"@zh ;
    mk:attrCode "notes" ;
    mk:hasValue mk:EnumValue_专用客户_京瓷,
        mk:EnumValue_专用客户_兰吉尔 ;
    mk:supports mk:Scenario_替代料推荐,
        mk:Scenario_物料精确查找 .

mk:CommonAttribute_优选标识属性 a owl:NamedIndividual,
        mk:CommonAttribute ;
    rdfs:label "优选标识属性"@zh ;
    rdfs:comment "由采购维护，标记物料是否为某个BG的优选物料；被标记为优选的物料，研发设计BOM时会优先考虑。"@zh ;
    skos:altLabel "preferredIdentification"@zh ;
    mk:attrCode "preferredIdentification" ;
    mk:hasValue mk:EnumValue_优选标识_优选1_汽电_,
        mk:EnumValue_优选标识_优选A,
        mk:EnumValue_优选标识_优选B ;
    mk:supports mk:Scenario_替代料推荐 .

mk:CommonAttribute_物料名称属性 a owl:NamedIndividual,
