    rdfs:comment "数据中实际出现的生命周期取值，业务含义待业务方说明。"@zh ;
    mk:enumCode "NG" .

mk:EnumValue_生命周期阶段_Preliminary a owl:NamedIndividual,
        mk:EnumValue ;
    rdfs:label "生命周期阶段-Preliminary"@zh ;
    rdfs:comment "数据中实际出现的生命周期取值，业务含义待业务方说明。"@zh ;
    mk:enumCode "Preliminary" .

mk:EnumValue_生命周期阶段_TA a owl:NamedIndividual,
        mk:EnumValue ;
    rdfs:label "生命周期阶段-TA"@zh ;
    rdfs:comment "数据中实际出现的生命周期取值，业务含义待业务方说明。"@zh ;
    mk:enumCode "TA" .

mk:EnumValue_生命周期阶段_YJ a owl:NamedIndividual,
        mk:EnumValue ;
    rdfs:label "生命周期阶段-YJ"@zh ;
    rdfs:comment "数据中实际出现的生命周期取值，业务含义待业务方说明。"@zh ;
    mk:enumCode "YJ" .

mk:EnumValue_生命周期阶段_完全停产 a owl:NamedIndividual,
        mk:EnumValue ;
    rdfs:label "生命周期阶段-完全停产"@zh ;
    rdfs:comment "物料完全停产。"@zh ;
    mk:enumCode "99" .

mk:EnumValue_生命周期阶段_完全失效 a owl:NamedIndividual,
        mk:EnumValue ;
    rdfs:label "生命周期阶段-完全失效"@zh ;
    rdfs:comment "物料完全失效。"@zh ;
    mk:enumCode "04" .

mk:EnumValue_生命周期阶段_批量 a owl:NamedIndividual,
        mk:EnumValue ;
    rdfs:label "生命周期阶段-批量"@zh ;
    rdfs:comment "物料处于批量阶段。"@zh ;
    mk:enumCode "AP" .

mk:EnumValue_生命周期阶段_测试 a owl:NamedIndividual,
        mk:EnumValue ;
    rdfs:label "生命周期阶段-测试"@zh ;
    rdfs:comment "物料处于测试阶段。"@zh ;
    mk:enumCode "NA" .

mk:EnumValue_生命周期阶段_研发 a owl:NamedIndividual,
        mk:EnumValue ;
    rdfs:label "生命周期阶段-研发"@zh ;
    rdfs:comment "物料处于研发阶段。"@zh ;
    mk:enumCode "YF" .

mk:EnumValue_生命周期阶段_试产 a owl:NamedIndividual,
        mk:EnumValue ;
    rdfs:label "生命周期阶段-试产"@zh ;
    rdfs:comment "物料处于试产阶段。"@zh ;
    mk:enumCode "CA" .

mk:EnumValue_生命周期阶段_部分失效 a owl:NamedIndividual,
        mk:EnumValue ;
    rdfs:label "生命周期阶段-部分失效"@zh ;
    rdfs:comment "物料部分失效。"@zh ;
    mk:enumCode "02" .

mk:EnumValue_生命周期阶段_采购失效 a owl:NamedIndividual,
        mk:EnumValue ;
    rdfs:label "生命周期阶段-采购失效"@zh ;
    rdfs:comment "物料对采购失效。"@zh ;
    mk:enumCode "03" .

mk:EnumValue_申请状态_SCM采购审批中 a owl:NamedIndividual,
        mk:EnumValue ;
    rdfs:label "申请状态-SCM采购审批中"@zh ;
    rdfs:comment "申请正在SCM采购审批。"@zh ;
    mk:enumCode "3" .

mk:EnumValue_申请状态_历史版本 a owl:NamedIndividual,
        mk:EnumValue ;
    rdfs:label "申请状态-历史版本"@zh ;
    rdfs:comment "物料升级后被新版本取代的旧记录。"@zh ;
    mk:enumCode "5" .

mk:EnumValue_申请状态_审批完成 a owl:NamedIndividual,
        mk:EnumValue ;
    rdfs:label "申请状态-审批完成"@zh ;
    rdfs:comment "审批通过的有效数据，同一物料编码只有一条。"@zh ;
    mk:enumCode "2" .

mk:EnumValue_申请状态_标准化审批中 a owl:NamedIndividual,
        mk:EnumValue ;
    rdfs:label "申请状态-标准化审批中"@zh ;
    rdfs:comment "申请已提交，正在标准化审批。"@zh ;
    mk:enumCode "1" .

mk:EnumValue_申请状态_草稿 a owl:NamedIndividual,
        mk:EnumValue ;
    rdfs:label "申请状态-草稿"@zh ;
    rdfs:comment "申请还没有提交。"@zh ;
    mk:enumCode "0" .

mk:EnumValue_申请状态_退回 a owl:NamedIndividual,
        mk:EnumValue ;
    rdfs:label "申请状态-退回"@zh ;
    rdfs:comment "申请被退回。"@zh ;
    mk:enumCode "4" .

mk:Field_L1分类 a owl:NamedIndividual,
        mk:Field ;
    rdfs:label "L1分类"@zh ;
    mk:javaField "classifyL1" ;
    mk:ownerEntity "物料主数据" .

mk:Field_L1分类代码 a owl:NamedIndividual,
        mk:Field ;
    rdfs:label "L1分类代码"@zh ;
    mk:javaField "firstCode" ;
    mk:ownerEntity "物料分类" .

mk:Field_L2分类 a owl:NamedIndividual,
        mk:Field ;
    rdfs:label "L2分类"@zh ;
    mk:javaField "classifyL2" ;
    mk:ownerEntity "物料主数据" .

mk:Field_L2分类代码 a owl:NamedIndividual,
        mk:Field ;
    rdfs:label "L2分类代码"@zh ;
    mk:javaField "secondCode" ;
    mk:ownerEntity "物料分类" .

mk:Field_L3分类 a owl:NamedIndividual,
        mk:Field ;
    rdfs:label "L3分类"@zh ;
    mk:javaField "classifyL3" ;
    mk:ownerEntity "物料主数据" .

mk:Field_L3分类代码 a owl:NamedIndividual,
        mk:Field ;
    rdfs:label "L3分类代码"@zh ;
    mk:javaField "thirdCode" ;
