  "rules": [
    {
      "name": "有效物料判定规则",
      "text": "物料主数据的申请状态表示申请审批状态，申请状态为2即审批完成的记录才是有效物料。同一个物料编码，申请状态为2的记录只有一条，进入图数据库的物料主数据只取申请状态为2的记录。",
      "source": "业务方说明",
      "basis": "confirmed"
    },
    {
      "name": "物料升级规则",
      "text": "物料升级时会新建一条物料主数据，物料编码保持不变；新建的升级记录审批通过后，申请状态改为2，原来申请状态为2的记录改为5即历史版本，因此同一物料编码始终只有一条有效记录。",
      "source": "业务方说明",
      "basis": "confirmed"
    },
    {
      "name": "物料状态口径规则",
      "text": "物料在业务上的物料状态以生命周期阶段属性为准。",
      "source": "业务方说明",
      "basis": "confirmed"
    },
    {
      "name": "物料编码BG前缀规则",
      "text": "汽车电子BG的物料编码以2开头，其他BG的物料编码以1开头；汽车电子BG的物料，其是否汽车电子为是。",
      "source": "业务方说明",
      "basis": "confirmed"
    },
    {
      "name": "客户专用料规则",
      "text": "专用客户属性有值的物料是客户专用料。属性值与客户名称、客户编码并不相等，但从字面上能看出是哪个客户，目前可选的客户只有两个。研发查找物料时可以过滤掉客户专用料。",
      "source": "业务方说明",
      "basis": "confirmed"
    },
    {
      "name": "分类代码层级规则",
      "text": "L4分类代码的前两位就是L1分类代码；物料主数据的L1分类、L2分类、L3分类、L4分类，分别对应物料分类里的L1分类代码、L2分类代码、L3分类代码、L4分类代码。",
      "source": "ClassificationAttributeRefServiceImpl#queryrangeCodeByfourCode (fourCode.substring(0, 2)); AddCodeApply.java @Dict",
      "basis": "code"
    },
    {
      "name": "分类属性范围匹配规则",
      "text": "物料分类属性模板与物料属性值库的L4分类代码有三种写法：具体的L4分类代码、L1分类代码，以及形如起始-终止的L1分类范围。按L4分类代码查询时，命中任意一种写法的记录都会返回，并按排序和物料短描述顺序排列。",
      "source": "ClassificationAttributeRefMapper.xml#queryrangeCodeByfourCode; AttributeValueMapper#queryRangeByFourCode",
      "basis": "code"
    },
    {
      "name": "属性值解析规则",
      "text": "解析分类属性时，属性类型为single、multiple、list或multList的属性，要到物料属性值库里查询可选值；其他类型的属性可选值为空。",
      "source": "ClassificationAttributeRefServiceImpl#getParsedValue",
      "basis": "code"
    },
    {
      "name": "物料描述拼接规则",
      "text": "物料短描述和英文描述取是否进ERP物料短描述标识为X或XY的属性，物料长描述取标识为Y或XY的属性，均按物料短描述顺序升序拼接；顺序小于1000的作为前缀，大于1000的作为后缀，私有属性夹在前缀和后缀之间；同一成组属性之间用成组属性拼接符连接，其余用空格连接。",
      "source": "AddCodeApplyServiceImpl#generateDescriptions",
      "basis": "code"
    },
    {
      "name": "物料基础属性取值规则",
      "text": "创建物料基础属性时，物料名称属性取自物料分类的物料子类L4，物料简称属性取自物料分类的元器件物料简称，物料类型属性取自物料编码号段的物料类型，其余属性按申请信息填充。",
      "source": "AddCodeApplyServiceImpl#createPublicAttributes",
      "basis": "code"
    },
    {
      "name": "编码号段选取规则",
      "text": "L1分类为38，或L4分类为40120101时，取该L4分类自己的号段；其他情况取L1分类加010101对应的号段。",
      "source": "CodeRangeServiceImpl#getCodeAndCommit",
      "basis": "code"
    },
    {
      "name": "汽车电子号段规则",
      "text": "汽车电子物料（即汽车电子BG的物料）使用汽车电子编码起始、汽车电子编码终止和汽车电子当前最大编码三个号段字段，其他物料使用普通的编码起始、编码终止和当前最大编码。",
      "source": "CodeRangeServiceImpl#getCodeAndCommit (addCodeApply.getEcar() == 1)",
      "basis": "code"
    },
    {
      "name": "旧物料编码校验规则",
      "text": "物料沿用旧物料编码时，旧物料编码必须是11位数字，不能与已有物料编码重复，且前4位必须与新生成编码的前4位一致。",
      "source": "CodeRangeServiceImpl#getCodeAndCommit",
      "basis": "code"
    }
  ],
  "scenarios": [
    {
      "name": "物料精确查找",
      "desc": "根据物料编码、描述关键字、分类或属性值，定位到具体的物料。"
    },
    {
      "name": "物料相似查找",
      "desc": "在同分类下找出属性相近的物料。"
    },
    {
      "name": "替代料推荐",
      "desc": "为某个物料推荐可以替换的其他物料。"
    }
  ]
}