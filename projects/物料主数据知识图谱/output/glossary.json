  "common_attributes": [
    {
      "canonical": "物料名称属性",
      "attr_code": "materialName",
      "desc": "物料的名称，创建时默认就是物料子类L4的名称。",
      "derives_from": "物料子类L4",
      "source": "AcAddCodeApplyAttrMapper.xml#getMaterialNameByMaterialNo; AddCodeApplyServiceImpl#createPublicAttributes"
    },
    {
      "canonical": "物料简称属性",
      "attr_code": "materialAbbreviation",
      "desc": "物料的简称，创建时默认来自分类上的元器件物料简称。",
      "derives_from": "元器件物料简称",
      "source": "AddCodeApplyServiceImpl#createPublicAttributes"
    },
    {
      "canonical": "物料类型属性",
      "attr_code": "materialType",
      "desc": "物料类型，创建时默认来自所在号段的物料类型。",
      "derives_from": "物料类型",
      "source": "AddCodeApplyServiceImpl#createPublicAttributes"
    },
    {
      "canonical": "生命周期阶段属性",
      "attr_code": "lifeCyclePhase",
      "desc": "物料在业务上的物料状态，分为研发、测试、试产、批量、EOL、部分失效、采购失效、完全失效、完全停产。",
      "derives_from": null,
      "source": "业务方说明; AddCodeApplyController#checkLifeCyclePhase"
    },
    {
      "canonical": "优选标识属性",
      "attr_code": "preferredIdentification",
      "desc": "由采购维护，标记物料是否为某个BG的优选物料；被标记为优选的物料，研发设计BOM时会优先考虑。",
      "derives_from": null,
      "source": "业务方说明; AcAddCodeApplyAttrServiceImpl#batchUpdateMaterialAttributes"
    },
    {
      "canonical": "制造商AVL等级属性",
      "attr_code": "manufacturerAvlRating",
      "desc": "物料对应制造商的AVL等级，每天晚上定时根据采购维护的制造商等级更新；研发设计BOM时优先考虑主力、合格、试用的物料。",
      "derives_from": null,
      "source": "业务方说明; AddCodeApplyController#checkParam"
    },
    {
      "canonical": "专用客户属性",
      "attr_code": "notes",
      "desc": "该属性有值表示物料是某个客户的专用料，属性值就是指定的专用客户；属性值与客户名称、客户编码并不相等，但从字面上能看出是同一个客户。",
      "derives_from": null,
      "source": "业务方说明"
    },
    {
      "canonical": "制造商名称属性",
      "attr_code": "manufacturersName",
      "desc": "物料对应的制造商名称。",
      "derives_from": null,
      "source": "AcAddCodeApplyAttrServiceImpl#getByMainIdAndPurchase"
    },
    {
      "canonical": "项目类型属性",
      "attr_code": "projectType",
      "desc": "物料所属项目的类型。",
      "derives_from": null,
      "source": "AcAddCodeApplyAttrServiceImpl#getByMainIdAndPurchase"
    },
    {
      "canonical": "品牌异常类型属性",
      "attr_code": "brandExceptionType",
      "desc": "品牌异常的类型；制造商AVL等级为考察、限制时必填，为主力、合格、试用时不能填写。",
      "derives_from": null,
      "source": "AddCodeApplyController#checkParam"
    },
    {
      "canonical": "细分类属性",
      "attr_code": "subdivision",
      "desc": "物料的细分类，取值的描述存放在物料属性值库里。",
      "derives_from": null,
      "source": "AttributeValueServiceImpl#getSubdivisionDesc"
    },
    {
      "canonical": "文档编号属性",
      "attr_code": "documentNumber",
      "desc": "物料关联的文档编号。",
      "derives_from": null,
      "source": "AddCodeApplyServiceImpl#handleNeed"
    }
  ],
