mk:Entity_物料编码号段 a owl:NamedIndividual,
        mk:Entity ;
    rdfs:label "物料编码号段"@zh ;
    rdfs:comment "即编码范围，业务上是物料编码号段，按L4分类划分起止号段并记录当前最大编码，用于顺序分配物料编码。"@zh ;
    skos:altLabel "CodeRange"@zh,
        "编码号段"@zh,
        "编码范围"@zh ;
