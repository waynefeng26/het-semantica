    rdfs:label "物料名称属性"@zh ;
    rdfs:comment "物料的名称，创建时默认就是物料子类L4的名称，是查找物料时最直观的属性。"@zh ;
    skos:altLabel "materialName"@zh ;
    mk:attrCode "materialName" ;
    mk:derivesFrom mk:Field_物料子类L4 ;
    mk:supports mk:Scenario_物料精确查找 .

