        mk:Entity ;
    rdfs:label "物料属性定义"@zh ;
    rdfs:comment "即属性维护，业务上是物料属性的定义清单，每个属性有属性代码和属性名称。"@zh ;
    skos:altLabel "AttributeManagement"@zh,
        "属性维护"@zh ;
    mk:hasKeyField mk:Field_属性代码,
        mk:Field_属性名称 ;
    mk:javaClass "AttributeManagement" ;
    mk:mapsToTable mk:DataTable_ac_attribute_management ;
    mk:tableName "ac_attribute_management" ;
    mk:techName "属性维护" .

