mk:includesAttribute a owl:ObjectProperty ;
    rdfs:label "包含常用属性"@zh ;
    rdfs:comment "物料基础属性包含的常用属性。"@zh ;
    rdfs:domain mk:Entity ;
    rdfs:range mk:CommonAttribute .

mk:Scenario_物料相似查找 a owl:NamedIndividual,
        mk:Scenario ;
    rdfs:label "物料相似查找"@zh ;
    rdfs:comment "在同分类下找出属性相近的物料。"@zh ;
    skos:scopeNote "相近标准因分类而异，没有统一标准。L1分类=28（包材）：核心技术属性里的尺寸类的数值属性（如长、宽、高，按属性名称判断，分类有哪些就比较哪些）每一项的取值之差（绝对值，单位一般是统一的）在±5以内表示相近，可以互为替代料或相似料；其他分类暂无标准。"@zh .

mk:Entity_物料分类 a owl:NamedIndividual,
        mk:Entity ;
    rdfs:label "物料分类"@zh ;
    rdfs:comment "即分类维护，业务上是物料分类体系，分为L1至L4四级，L4是最末级分类。"@zh ;
    skos:altLabel "ClassificationManagement"@zh,
        "分类维护"@zh,
        "物料分类维护"@zh ;
    mk:governedBy mk:BusinessRule_分类代码层级规则,
        mk:BusinessRule_分类相近标准规则 ;
    mk:hasKeyField mk:Field_L1分类代码,
        mk:Field_L2分类代码,
        mk:Field_L3分类代码,
        mk:Field_L4分类代码,
        mk:Field_元器件物料简称,
        mk:Field_是否涉及优选,
        mk:Field_标准件_非标准件,
        mk:Field_物料子类L4 ;
    mk:javaClass "ClassificationManagement" ;
    mk:mapsToTable mk:DataTable_ac_classification_management ;
    mk:tableName "ac_classification_management" ;
    mk:techName "分类维护" .

mk:Scenario_替代料推荐 a owl:NamedIndividual,
        mk:Scenario ;
    rdfs:label "替代料推荐"@zh ;
    rdfs:comment "为某个物料推荐可以替换的其他物料。"@zh ;
    skos:scopeNote "MPN → 核心技术属性比较：由制造商零件编号找到物料主数据，沿L4分类找到对应的物料分类属性模板和物料私有属性，比较两个物料的核心技术属性（物料私有属性中，模板里是否必填为X的属性）是否相近，相近的标准因分类而异，相近则互为替代料。路径：物料基础属性 -includesAttribute-> 制造商零件编号属性；物料基础属性 -partOf-> 物料主数据；物料主数据 -refersTo-> 物料分类；物料分类属性模板 -refersTo-> 物料分类；物料私有属性 -refersTo-> 物料分类属性模板；物料分类属性模板 -hasKeyField-> 是否必填；物料私有属性 -partOf-> 物料主数据"@zh,
        "相近标准因分类而异，没有统一标准。L1分类=28（包材）：核心技术属性里的尺寸类的数值属性（如长、宽、高，按属性名称判断，分类有哪些就比较哪些）每一项的取值之差（绝对值，单位一般是统一的）在±5以内表示相近，可以互为替代料或相似料；其他分类暂无标准。"@zh .

mk:CommonAttribute_生命周期阶段属性 a owl:NamedIndividual,
        mk:CommonAttribute ;
    rdfs:label "生命周期阶段属性"@zh ;
    rdfs:comment "物料在业务上的物料状态，分为研发、测试、试产、批量、EOL、部分失效、采购失效、完全失效、完全停产。"@zh ;
    skos:altLabel "lifeCyclePhase"@zh ;
    mk:attrCode "lifeCyclePhase" ;
    mk:hasValue mk:EnumValue_生命周期阶段_05,
        mk:EnumValue_生命周期阶段_EOL,
        mk:EnumValue_生命周期阶段_GA,
        mk:EnumValue_生命周期阶段_NG,
        mk:EnumValue_生命周期阶段_Preliminary,
        mk:EnumValue_生命周期阶段_TA,
        mk:EnumValue_生命周期阶段_YJ,
        mk:EnumValue_生命周期阶段_完全停产,
        mk:EnumValue_生命周期阶段_完全失效,
        mk:EnumValue_生命周期阶段_批量,
        mk:EnumValue_生命周期阶段_测试,
        mk:EnumValue_生命周期阶段_研发,
        mk:EnumValue_生命周期阶段_试产,
        mk:EnumValue_生命周期阶段_部分失效,
        mk:EnumValue_生命周期阶段_采购失效 ;
    mk:supports mk:Scenario_替代料推荐,
        mk:Scenario_物料精确查找 .

