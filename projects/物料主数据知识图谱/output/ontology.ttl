mk:BusinessGroup_汽车电子BG a owl:NamedIndividual,
        mk:BusinessGroup ;
    rdfs:label "汽车电子BG"@zh .

mk:BusinessRule_分类代码层级规则 a owl:NamedIndividual,
        mk:BusinessRule ;
    rdfs:label "分类代码层级规则"@zh ;
    rdfs:comment "L4分类代码的前两位就是L1分类代码；物料主数据的L1分类、L2分类、L3分类、L4分类，分别对应物料分类里的L1分类代码、L2分类代码、L3分类代码、L4分类代码。"@zh ;
    mk:ruleSource "ClassificationAttributeRefServiceImpl#queryrangeCodeByfourCode (fourCode.substring(0, 2)); AddCodeApply.java @Dict" .

mk:BusinessRule_分类属性范围匹配规则 a owl:NamedIndividual,
        mk:BusinessRule ;
    rdfs:label "分类属性范围匹配规则"@zh ;
    rdfs:comment "物料分类属性模板与物料属性值库的L4分类代码有三种写法：具体的L4分类代码、L1分类代码，以及形如起始-终止的L1分类范围。按L4分类代码查询时，命中任意一种写法的记录都会返回，并按排序和物料短描述顺序排列。"@zh ;
    mk:ruleSource "ClassificationAttributeRefMapper.xml#queryrangeCodeByfourCode; AttributeValueMapper#queryRangeByFourCode" .

mk:BusinessRule_属性值解析规则 a owl:NamedIndividual,
        mk:BusinessRule ;
    rdfs:label "属性值解析规则"@zh ;
    rdfs:comment "解析分类属性时，属性类型为single、multiple、list或multList的属性，要到物料属性值库里查询可选值；其他类型的属性可选值为空。"@zh ;
    mk:ruleSource "ClassificationAttributeRefServiceImpl#getParsedValue" .

mk:BusinessRule_替代料判断流程 a owl:NamedIndividual,
        mk:BusinessRule ;
    rdfs:label "替代料判断流程"@zh ;
    rdfs:comment "判断两个制造商零件编号属性对应的物料是否互为替代料：先由制造商零件编号属性找到所在的物料主数据，再由物料主数据的L4分类找到对应的物料分类属性模板，进而找到该分类下的物料私有属性，比较两个物料的核心技术属性（物料私有属性中，物料分类属性模板的是否必填为X的属性）是否相近，相近的标准因分类而异，相近则互为替代料。"@zh ;
    mk:ruleSource "业务方说明" .

mk:BusinessRule_物料描述拼接规则 a owl:NamedIndividual,
        mk:BusinessRule ;
    rdfs:label "物料描述拼接规则"@zh ;
    rdfs:comment "物料短描述和英文描述取是否进ERP物料短描述标识为X或XY的属性，物料长描述取标识为Y或XY的属性，均按物料短描述顺序升序拼接；顺序小于1000的作为前缀，大于1000的作为后缀，私有属性夹在前缀和后缀之间；同一成组属性之间用成组属性拼接符连接，其余用空格连接。"@zh ;
    mk:ruleSource "AddCodeApplyServiceImpl#generateDescriptions" .

mk:BusinessRule_物料查重规则 a owl:NamedIndividual,
        mk:BusinessRule ;
    rdfs:label "物料查重规则"@zh ;
    rdfs:comment "新增物料前要查重：通用件按制造商零件编号属性加制造商名称属性查重，定制件按图号属性加制造商名称属性查重；查重时排除当前记录、升级前的历史版本，以及LOA标识为是的物料。"@zh ;
    mk:ruleSource "AddCodeApplyController#dupCheck" .

