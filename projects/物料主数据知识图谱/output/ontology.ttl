@prefix mk: <https://terra.szhittech.com/ontology/material-master#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://terra.szhittech.com/ontology/material-master> a owl:Ontology ;
    rdfs:label "物料主数据知识图谱本体"@zh ;
    rdfs:comment "和而泰物料主数据本体：描述物料主数据、基础属性、私有属性、分类、属性定义、分类属性模板、属性值库、编码号段之间的结构，以及常用属性、枚举值、业务规则和应用场景（物料精确查找、物料相似查找、替代料推荐）。"@zh ;
    owl:versionInfo "1.0" .

mk:attrCode a owl:DatatypeProperty ;
    rdfs:label "属性代码（attr_code）"@zh ;
    rdfs:domain mk:CommonAttribute ;
    rdfs:range xsd:string .

mk:basis a owl:AnnotationProperty ;
    rdfs:label "依据"@zh .

mk:dictCode a owl:DatatypeProperty ;
    rdfs:label "字典编码"@zh ;
    rdfs:domain mk:Dictionary ;
    rdfs:range xsd:string .

mk:enumCode a owl:DatatypeProperty ;
    rdfs:label "枚举编码"@zh ;
    rdfs:domain mk:EnumValue ;
    rdfs:range xsd:string .

mk:javaClass a owl:DatatypeProperty ;
    rdfs:label "Java 类名"@zh ;
    rdfs:domain mk:Entity ;
    rdfs:range xsd:string .

mk:javaField a owl:DatatypeProperty ;
    rdfs:label "Java 字段名"@zh ;
    rdfs:domain mk:Field ;
    rdfs:range xsd:string .

mk:ownerEntity a owl:DatatypeProperty ;
    rdfs:label "所属业务实体"@zh ;
    rdfs:domain mk:Field ;
    rdfs:range xsd:string .

mk:ruleSource a owl:DatatypeProperty ;
    rdfs:label "规则出处"@zh ;
    rdfs:domain mk:BusinessRule ;
    rdfs:range xsd:string .

mk:source a owl:AnnotationProperty ;
    rdfs:label "出处"@zh .

mk:tableName a owl:DatatypeProperty ;
    rdfs:label "数据表名"@zh ;
    rdfs:domain mk:Entity ;
    rdfs:range xsd:string .

mk:techName a owl:DatatypeProperty ;
    rdfs:label "源码 / 技术侧叫法"@zh ;
    rdfs:domain mk:Entity ;
    rdfs:range xsd:string .

mk:via a owl:AnnotationProperty ;
    rdfs:label "关联字段"@zh .

mk:Field_单选_多选 a owl:NamedIndividual,
        mk:Field ;
    rdfs:label "单选/多选"@zh ;
    mk:javaField "smc" ;
    mk:ownerEntity "物料分类属性模板" ;
    mk:usesDictionary mk:Dictionary_smc字典 .

mk:indicatesBG a owl:ObjectProperty ;
    rdfs:label "标明所属BG"@zh ;
    rdfs:comment "字段标明物料所属的 BG。"@zh ;
    rdfs:domain mk:Field ;
    rdfs:range mk:BusinessGroup .

mk:similarTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "语义相近"@zh ;
    rdfs:comment "语义相近（由语义分析推断，对称）。"@zh ;
    rdfs:domain mk:Entity ;
    rdfs:range mk:Entity .

mk:BusinessGroup_国内家电BG a owl:NamedIndividual,
        mk:BusinessGroup ;
    rdfs:label "国内家电BG"@zh .

mk:BusinessGroup_海外家电BG a owl:NamedIndividual,
        mk:BusinessGroup ;
    rdfs:label "海外家电BG"@zh .

mk:BusinessRule_MPN相近替代判断规则 a owl:NamedIndividual,
        mk:BusinessRule ;
    rdfs:label "MPN相近替代判断规则"@zh ;
    rdfs:comment "制造商零件编号属性的前缀或系列号相同，不能单独判断是否算替代料，要结合L4分类和物料私有属性一起判断。"@zh ;
    mk:ruleSource "业务方说明" .

mk:BusinessRule_分类相近标准规则 a owl:NamedIndividual,
        mk:BusinessRule ;
    rdfs:label "分类相近标准规则"@zh ;
    rdfs:comment "物料相近的标准因分类而异，没有统一标准，核心技术属性取值的单位一般是统一的，按绝对差比较。L1分类为28（包材）的物料，核心技术属性里凡是长、宽、高这类尺寸数值属性，该分类有哪些就比较哪些，取值之差都在正负5以内才表示相近，可以互为替代料或相似料；不是每个包材分类都有长、宽、高。哪些属性算尺寸类，目前先按属性名称判断。"@zh ;
    mk:ruleSource "业务方说明" .

mk:BusinessRule_制造商AVL等级筛选规则 a owl:NamedIndividual,
        mk:BusinessRule ;
    rdfs:label "制造商AVL等级筛选规则"@zh ;
    rdfs:comment "使用时一般只筛选制造商AVL等级为主力、合格、试用的物料，其他取值一律认为不及格；数据里出现的其他取值（例如“考察(暂定)”“AVL-C”）属于不规范数据，暂时忽略，不单独建枚举值。"@zh ;
    mk:ruleSource "业务方说明" .

mk:BusinessRule_客户专用料规则 a owl:NamedIndividual,
        mk:BusinessRule ;
    rdfs:label "客户专用料规则"@zh ;
    rdfs:comment "专用客户属性有值的物料是客户专用料，属性值保存的是客户编码（A001对应兰吉尔，A002对应京瓷），目前只有这两个客户。研发查找物料时可以过滤掉客户专用料。"@zh ;
    mk:ruleSource "业务方说明" .

mk:BusinessRule_旧物料编码校验规则 a owl:NamedIndividual,
        mk:BusinessRule ;
    rdfs:label "旧物料编码校验规则"@zh ;
    rdfs:comment "物料沿用旧物料编码时，旧物料编码必须是11位数字，不能与已有物料编码重复，且前4位必须与新生成编码的前4位一致。"@zh ;
    mk:ruleSource "CodeRangeServiceImpl#getCodeAndCommit" .

mk:BusinessRule_有效物料判定规则 a owl:NamedIndividual,
        mk:BusinessRule ;
    rdfs:label "有效物料判定规则"@zh ;
    rdfs:comment "物料主数据的申请状态表示申请审批状态，申请状态为2即审批完成的记录才是有效物料。同一个物料编码，申请状态为2的记录只有一条，进入图数据库的物料主数据只取申请状态为2的记录。"@zh ;
    mk:ruleSource "业务方说明" .

mk:BusinessRule_核心技术属性判定规则 a owl:NamedIndividual,
        mk:BusinessRule ;
    rdfs:label "核心技术属性判定规则"@zh ;
    rdfs:comment "物料私有属性中，物料分类属性模板的是否必填为X的属性，是核心技术属性；公有属性不算核心技术属性。"@zh ;
    mk:ruleSource "业务方说明" .

mk:BusinessRule_汽车电子号段规则 a owl:NamedIndividual,
        mk:BusinessRule ;
    rdfs:label "汽车电子号段规则"@zh ;
    rdfs:comment "汽车电子物料（即汽车电子BG的物料）使用汽车电子编码起始、汽车电子编码终止和汽车电子当前最大编码三个号段字段，其他物料使用普通的编码起始、编码终止和当前最大编码。"@zh ;
    mk:ruleSource "CodeRangeServiceImpl#getCodeAndCommit (addCodeApply.getEcar() == 1)" .

mk:BusinessRule_物料升级规则 a owl:NamedIndividual,
        mk:BusinessRule ;
    rdfs:label "物料升级规则"@zh ;
    rdfs:comment "物料升级时会新建一条物料主数据，物料编码保持不变；新建的升级记录审批通过后，申请状态改为2，原来申请状态为2的记录改为5即历史版本，因此同一物料编码始终只有一条有效记录。"@zh ;
    mk:ruleSource "业务方说明" .

mk:BusinessRule_物料基础属性取值规则 a owl:NamedIndividual,
        mk:BusinessRule ;
    rdfs:label "物料基础属性取值规则"@zh ;
    rdfs:comment "创建物料基础属性时，物料名称属性取自物料分类的物料子类L4，物料简称属性取自物料分类的元器件物料简称，物料类型属性取自物料编码号段的物料类型，其余属性按申请信息填充。"@zh ;
    mk:ruleSource "AddCodeApplyServiceImpl#createPublicAttributes" .

mk:BusinessRule_物料状态口径规则 a owl:NamedIndividual,
        mk:BusinessRule ;
    rdfs:label "物料状态口径规则"@zh ;
    rdfs:comment "物料在业务上的物料状态以生命周期阶段属性为准。"@zh ;
    mk:ruleSource "业务方说明" .

mk:BusinessRule_物料编码BG前缀规则 a owl:NamedIndividual,
        mk:BusinessRule ;
    rdfs:label "物料编码BG前缀规则"@zh ;
    rdfs:comment "物料编码以2开头的是汽车电子BG的物料（汽车电子物料），其他编码开头的一律是非汽车电子物料；汽车电子BG的物料，其是否汽车电子为是。"@zh ;
    mk:ruleSource "业务方说明" .

mk:BusinessRule_编码号段选取规则 a owl:NamedIndividual,
        mk:BusinessRule ;
    rdfs:label "编码号段选取规则"@zh ;
    rdfs:comment "L1分类为38，或L4分类为40120101时，取该L4分类自己的号段；其他情况取L1分类加010101对应的号段。"@zh ;
    mk:ruleSource "CodeRangeServiceImpl#getCodeAndCommit" .

mk:CommonAttribute_品牌异常类型属性 a owl:NamedIndividual,
        mk:CommonAttribute ;
    rdfs:label "品牌异常类型属性"@zh ;
    rdfs:comment "品牌异常的类型；制造商AVL等级为考察、限制时必填，为主力、合格、试用时不能填写。"@zh ;
    skos:altLabel "brandExceptionType"@zh ;
    mk:attrCode "brandExceptionType" .

mk:CommonAttribute_文档编号属性 a owl:NamedIndividual,
        mk:CommonAttribute ;
    rdfs:label "文档编号属性"@zh ;
    rdfs:comment "物料关联的文档编号。"@zh ;
    skos:altLabel "documentNumber"@zh ;
    mk:attrCode "documentNumber" .

mk:CommonAttribute_项目类型属性 a owl:NamedIndividual,
        mk:CommonAttribute ;
    rdfs:label "项目类型属性"@zh ;
    rdfs:comment "物料所属项目的类型。"@zh ;
    skos:altLabel "projectType"@zh ;
    mk:attrCode "projectType" .

mk:DataTable_ac_add_code_apply a owl:NamedIndividual,
        mk:DataTable ;
    rdfs:label "ac_add_code_apply"@zh .

mk:DataTable_ac_add_code_apply_attr a owl:NamedIndividual,
        mk:DataTable ;
    rdfs:label "ac_add_code_apply_attr"@zh .

mk:DataTable_ac_add_code_apply_attrp a owl:NamedIndividual,
        mk:DataTable ;
    rdfs:label "ac_add_code_apply_attrp"@zh .

mk:DataTable_ac_attribute_management a owl:NamedIndividual,
        mk:DataTable ;
    rdfs:label "ac_attribute_management"@zh .

mk:DataTable_ac_attribute_value a owl:NamedIndividual,
        mk:DataTable ;
    rdfs:label "ac_attribute_value"@zh .

mk:DataTable_ac_classification_attribute_ref a owl:NamedIndividual,
        mk:DataTable ;
    rdfs:label "ac_classification_attribute_ref"@zh .

mk:DataTable_ac_classification_management a owl:NamedIndividual,
        mk:DataTable ;
    rdfs:label "ac_classification_management"@zh .

mk:DataTable_ac_code_range a owl:NamedIndividual,
        mk:DataTable ;
    rdfs:label "ac_code_range"@zh .

mk:Dictionary_attrType字典 a owl:NamedIndividual,
        mk:Dictionary ;
    rdfs:label "attrType字典"@zh ;
    mk:dictCode "attrType" .

mk:Dictionary_pubOrPri字典 a owl:NamedIndividual,
        mk:Dictionary ;
    rdfs:label "pubOrPri字典"@zh ;
    mk:dictCode "pubOrPri" .

mk:Dictionary_smc字典 a owl:NamedIndividual,
        mk:Dictionary ;
    rdfs:label "smc字典"@zh ;
    mk:dictCode "smc" .

mk:EnumValue_专用客户_京瓷 a owl:NamedIndividual,
        mk:EnumValue ;
    rdfs:label "专用客户-京瓷"@zh ;
    rdfs:comment "客户京瓷的专用料，属性值保存客户编码A002。"@zh ;
    skos:altLabel "A002"@zh,
        "京瓷"@zh ;
    mk:enumCode "A002" .

mk:EnumValue_专用客户_兰吉尔 a owl:NamedIndividual,
        mk:EnumValue ;
    rdfs:label "专用客户-兰吉尔"@zh ;
    rdfs:comment "客户兰吉尔的专用料，属性值保存客户编码A001。"@zh ;
    skos:altLabel "A001"@zh,
        "兰吉尔"@zh ;
    mk:enumCode "A001" .

mk:EnumValue_制造商AVL等级_主力 a owl:NamedIndividual,
        mk:EnumValue ;
    rdfs:label "制造商AVL等级-主力"@zh ;
    rdfs:comment "研发设计BOM时优先考虑。"@zh ;
    mk:enumCode "主力" .

mk:EnumValue_制造商AVL等级_合格 a owl:NamedIndividual,
        mk:EnumValue ;
    rdfs:label "制造商AVL等级-合格"@zh ;
    rdfs:comment "研发设计BOM时优先考虑。"@zh ;
    mk:enumCode "合格" .

mk:EnumValue_制造商AVL等级_考察 a owl:NamedIndividual,
        mk:EnumValue ;
    rdfs:label "制造商AVL等级-考察"@zh ;
    rdfs:comment "物料对应的制造商不合格或未验证，研发设计BOM时不优先考虑。"@zh ;
    mk:enumCode "考察" .

mk:EnumValue_制造商AVL等级_试用 a owl:NamedIndividual,
        mk:EnumValue ;
    rdfs:label "制造商AVL等级-试用"@zh ;
    rdfs:comment "研发设计BOM时优先考虑。"@zh ;
    mk:enumCode "试用" .

mk:EnumValue_制造商AVL等级_限制 a owl:NamedIndividual,
        mk:EnumValue ;
    rdfs:label "制造商AVL等级-限制"@zh ;
    rdfs:comment "处理方式和考察一样：物料对应的制造商不合格或未验证，研发设计BOM时不优先考虑。"@zh ;
    mk:enumCode "限制" .

mk:EnumValue_生命周期阶段_05 a owl:NamedIndividual,
        mk:EnumValue ;
    rdfs:label "生命周期阶段-05"@zh ;
    rdfs:comment "数据中实际出现的生命周期取值，业务含义待业务方说明。"@zh ;
    mk:enumCode "05" .

mk:EnumValue_生命周期阶段_EOL a owl:NamedIndividual,
        mk:EnumValue ;
    rdfs:label "生命周期阶段-EOL"@zh ;
    rdfs:comment "物料为EOL状态。"@zh ;
    mk:enumCode "00" .

mk:EnumValue_生命周期阶段_GA a owl:NamedIndividual,
        mk:EnumValue ;
    rdfs:label "生命周期阶段-GA"@zh ;
    rdfs:comment "数据中实际出现的生命周期取值，业务含义待业务方说明。"@zh ;
    mk:enumCode "GA" .

mk:EnumValue_生命周期阶段_NG a owl:NamedIndividual,
        mk:EnumValue ;
